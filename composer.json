{
  "name": "eric-therond/php-cfg-protobuf-printer",
  "description": "A Protobuf printer for PHP-CFG",
  "license": "MIT",
  "authors": [
    {
      "name": "Eric Therond",
      "email": "eric.therond.fr@gmail.com"
    }
  ],
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/eric-therond/php-cfg.git"
    }
  ],
  "require": {
    "php": ">=8.4.1",
    "ircmaxell/php-cfg": "dev-proto_printer_refactor",
    "google/protobuf": "5.35.1"
  },
  "require-dev": {
    "phpunit/phpunit": "13.2.2",
    "friendsofphp/php-cs-fixer": "3.95.11"
  },
  "autoload": {
    "psr-4": {
      "ProtobufPrinter\\": "lib/ProtobufPrinter/"
    }
  }
}