<?php

try {
    if(doBar()) {
        throw new Exception('foo');
    } else if(doFoo()) {
        doFi();
    } else {
        doFi();
    }
} catch (Exception $e) {
    return $e;
} finally {
    echo 'finally';
}

echo "next";
