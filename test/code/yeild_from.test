<?php
function gen_one_to_three() {
    for ($i = 1; $i <= 3; $i++) {
        // Note that $i is preserved between yields.
        yield $i;
    }
}
function gen_zero_four() {
    yield 0;
    yield from gen_one_to_three();
    yield 4;
}
